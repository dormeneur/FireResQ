<?xml version="1.0"?>
<!--
  FireResQ fire source - a simulated fire: a static, emissive orange-red flame column.

  REPLACEABLE BY DESIGN (PRD.md section 6: "a real visual fire representation may replace the
  simulated fire during physical testing"). The scenario names the fire by model
  (`fire: {model: fire, ...}`), so swapping in a different flame model is a one-line scenario
  change. What the rest of the system may rely on is only the CONTRACT below, never this
  model's internals:

    * a single entity named `fire`, placed by the scenario;
    * it looks like a saturated orange/red blob (hue ~0-25 in OpenCV HSV, high value) that
      contrasts with the low-saturation floor and walls - this is what the Phase 5 detector
      keys on, and what a real flame or orange lamp would also present;
    * it is an obstacle (the robot must not drive into it).

  The fire is NOT dynamic: it does not spread, flicker or emit heat. It is emissive, so its
  colour does not depend on scene lighting - which also makes it a stable perception target.
  TODO(future): dynamic fire-risk modelling (spread, growth) - explicitly out of the MVP.
  TODO(hardware): the physical fire stand-in (orange lamp / flame image) and its size.
-->
<sdf version="1.9">
  <model name="fire">
    <static>true</static>
    <link name="base_link">

      <!-- embers -->
      <visual name="embers">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.1 0 1</ambient><diffuse>0.7 0.1 0 1</diffuse>
          <emissive>0.75 0.12 0 1</emissive>
        </material>
      </visual>

      <!-- outer flame -->
      <visual name="flame_outer">
        <pose>0 0 0.27 0 0 0</pose>
        <geometry><cone><radius>0.13</radius><length>0.42</length></cone></geometry>
        <material>
          <ambient>1 0.28 0 1</ambient><diffuse>1 0.28 0 1</diffuse>
          <emissive>1 0.28 0 1</emissive>
        </material>
      </visual>

      <!-- inner flame -->
      <visual name="flame_inner">
        <pose>0 0 0.21 0 0 0</pose>
        <geometry><cone><radius>0.07</radius><length>0.30</length></cone></geometry>
        <material>
          <ambient>1 0.72 0.1 1</ambient><diffuse>1 0.72 0.1 1</diffuse>
          <emissive>1 0.72 0.1 1</emissive>
        </material>
      </visual>

      <!-- the whole column is an obstacle -->
      <collision name="hazard_collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
      </collision>

    </link>
  </model>
</sdf>
