<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fire_resq_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo simulation assets for FireResQ: worlds, models, bridge configuration and
    simulation launch files. All Gazebo-specific content lives here, keeping
    fire_resq_description reusable on the physical robot.
  </description>
  <maintainer email="adityabharti1214@gmail.com">Aditya Bharti</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>fire_resq_description</exec_depend>
  <exec_depend>fire_resq_navigation</exec_depend>
  <exec_depend>fire_resq_perception</exec_depend>
  <exec_depend>fire_resq_world_model</exec_depend>
  <exec_depend>fire_resq_cognition</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
