<?xml version="1.0"?>
<!--
  Standard inertia tensors for primitive shapes.
  TODO(hardware): these assume uniform density. Replace with measured values once the
  real chassis exists - Nav2 controller tuning depends on plausible inertia.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertia" params="m x y z ox:=0.0">
    <inertial>
      <!-- ox: centre-of-mass offset along x from the link origin. -->
      <origin xyz="${ox} 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
               iyy="${2.0*m*r*r/5.0}" iyz="0.0"
               izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

</robot>
