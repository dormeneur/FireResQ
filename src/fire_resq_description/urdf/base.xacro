<?xml version="1.0"?>
<!-- Chassis and the single passive caster. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    base_link is the root of the robot and sits at the MIDPOINT OF THE DRIVE AXLE (see
    parameters.xacro, "FRAME CONVENTION"), at axle height. The chassis is therefore offset
    from it by chassis_x_offset. Architecture.md section 5 defines the frame chain as
    map -> odom -> base_link -> camera frame(s); base_link is where that chain enters
    the robot, so no base_footprint is introduced.
  -->
  <link name="base_link">
    <visual>
      <origin xyz="${chassis_x_offset} 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="${chassis_x_offset} 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}" ox="${chassis_x_offset}"/>
  </link>

  <!--
    Passive caster. Modelled as a fixed sphere: it carries no actuation and no encoder,
    so it contributes no joint state. Low friction is applied in the SIMULATION package,
    not here - surface properties are simulator concerns.
  -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_silver"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

</robot>
